# ==========================================
# SIGEPRO - Variables de Entorno
# ==========================================

# Supabase Configuration
# Obtén estos valores desde: Supabase Dashboard -> Project Settings -> API
VITE_SUPABASE_URL="https://tu-proyecto.supabase.co"
VITE_SUPABASE_ANON_KEY="tu-anon-public-key"

# App URL (Opcional, usado para enlaces de retorno y notificaciones)
VITE_APP_URL="http://localhost:3000"

# --- Resend API (correos electrónicos) ---
# En producción: el correo se envía por la Edge Function de Supabase (segura, clave en servidor).
# Configura el secreto en: Supabase Dashboard -> Edge Functions -> Secrets
#   RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
#
# Para desarrollo local (fallback directo desde browser):
VITE_RESEND_API_KEY="re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
