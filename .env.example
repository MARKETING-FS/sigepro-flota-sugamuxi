# ==========================================
# SIGEPRO - Variables de Entorno
# ==========================================

# 1. Supabase Configuration (Base de Datos & Storage)
# Obtén estos valores desde: Supabase Dashboard -> Project Settings -> API
VITE_SUPABASE_URL="https://tu-proyecto.supabase.co"
VITE_SUPABASE_ANON_KEY="tu-anon-public-key"

# App URL (Opcional, usado para enlaces de retorno y notificaciones)
VITE_APP_URL="http://localhost:3000"

# 2. Resend API (Correos electrónicos institucionales)
# En producción: el correo se envía por la Edge Function de Supabase (segura, clave en servidor).
# Configura el secreto en: Supabase Dashboard -> Edge Functions -> Secrets
#   RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Para desarrollo local (fallback directo desde browser):
VITE_RESEND_API_KEY="re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"

# 3. Configuración de Almacenamiento (Storage)
# Proveedor activo: 'supabase' (por defecto) o 'onedrive'
VITE_STORAGE_PROVIDER="supabase"

# 4. Microsoft OneDrive / SharePoint (Microsoft Graph API)
# Preparado para conectar cuando se disponga de la suscripción de Microsoft 365:
# - Registrar una aplicación en Azure Active Directory (portal.azure.com)
# - Conceder permisos Files.ReadWrite.All en Microsoft Graph
VITE_ONEDRIVE_TENANT_ID=""
VITE_ONEDRIVE_CLIENT_ID=""
VITE_ONEDRIVE_CLIENT_SECRET=""
VITE_ONEDRIVE_DRIVE_ID=""
VITE_ONEDRIVE_ROOT_FOLDER="SIGEPRO_Proveedores"
